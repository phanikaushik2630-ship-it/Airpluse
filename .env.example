# Server Port
PORT=5000

# WAQI (World Air Quality Index) API Token
# Get your free token at: https://aqicn.org/data-platform/token/
WAQI_API_TOKEN=your_waqi_api_token_here

# Configurable comma-separated list of cities to monitor and poll
MONITORED_CITIES=Delhi,Mumbai,Hyderabad,Bengaluru,Kolkata,Chennai

# Scheduled polling interval (cron syntax, e.g. */15 * * * * for every 15 minutes)
# For testing, can be set to */5 * * * * or */10 * * * *
POLL_INTERVAL_CRON=*/15 * * * *

# Enable or disable automatic background polling on server startup (true/false)
AUTO_POLL_ENABLED=true

# Database Path
DB_PATH=./data/airpulse.sqlite
